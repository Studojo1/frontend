FROM oven/bun:1-debian AS deps

WORKDIR /app
COPY package.json bun.lockb ./
RUN bun install --frozen-lockfile

# Install Patchright's Chromium + system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libdbus-1-3 libxkbcommon0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libasound2 libxshmfence1 \
    libx11-xcb1 libxcb-dri3-0 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

RUN bunx patchright install chromium

FROM oven/bun:1-debian AS runner

WORKDIR /app

# Copy system Chromium deps
COPY --from=deps /usr/lib /usr/lib
COPY --from=deps /usr/share/fonts /usr/share/fonts

# Copy Patchright browser cache
COPY --from=deps /root/.cache/ms-playwright /root/.cache/ms-playwright

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NODE_ENV=production

CMD ["bun", "app/workers/index.ts"]
