# Database (local: localhost; Docker overrides via docker-compose)
DATABASE_URL=postgresql://studojo:studojo@localhost:5432/postgres

# Azure OpenAI: every OpenAI model call goes here (app/lib/azure-openai.server.ts)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# Optional deployment names (defaults: gpt-4o, gpt-4o-mini)
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini

# Better Auth
BETTER_AUTH_SECRET=your-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio Verify API (phone OTP). Required for sending and verifying codes.
# Uses Twilio Verify API which handles OTP generation, delivery, and verification.
# sendOTP is fire-and-forget (not awaited) per better-auth recommendation.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional: comma-separated user IDs for admin access
# ADMIN_USER_IDS=id1,id2

# Control plane (Assignment Dojo jobs)
VITE_CONTROL_PLANE_URL=http://localhost:8080

# Content Studio (/content, studojo.pro only)
# Comma separated Google addresses allowed into /content. Leave unset to use
# the two accounts hardcoded in app/lib/content/guard.server.ts.
# CONTENT_ALLOWED_EMAILS=
# Model used by the idea generator and the writer. Defaults to gpt-4o.
# CONTENT_MODEL=gpt-4o
