{
  "manifest_version": 3,
  "name": "Studojo LinkedIn Connect",
  "version": "1.1.0",
  "description": "Connect your LinkedIn to Studojo — find the right people to message for any role you want.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://studojo.com/*",
    "https://studojo.pro/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://studojo.com/outreach/linkedin*", "https://studojo.pro/outreach/linkedin*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
